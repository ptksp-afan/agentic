# Salin ke config/workspace.env (gitignored) lalu sesuaikan dengan mesin ini.
# Format KEY=value, path pakai garis miring maju. Env proses menimpa nilai di sini.
# Nilai di bawah = mesin developer (Windows, 2026-10-06).

# --- Repo -------------------------------------------------------------------
BE_DIR=D:/dev/ksp-erp-next               # checkout v5-rr. JANGAN arahkan ke ksp-erp-next-multidb (milik pipeline multidb)
BE_BRANCH=v5-rr                          # preflight menolak jalan kalau branch berbeda
FE_DIR=D:/dev/ksp-react-v5               # worktree next-canvasing (README "Setup"); D:/dev/ksp-react dipakai multidb
FE_BRANCH=next-canvasing

# --- BE ---------------------------------------------------------------------
PHP_BIN=C:/Program Files/SystemEQ/php-nts/php.exe   # PHP yang sama dengan worker RR (7.3.33 NTS); php di PATH = build lain
API_URL=http://127.0.0.1:8002            # server BE milik BE_DIR; port RR per checkout ada di <BE_DIR>/.rr.env (RR_HTTP_ADDRESS)
BE_SERVER=rr                             # rr = RoadRunner (reload sesudah ubah PHP/.env); fpm = php-fpm/Apache/artisan serve
BE_RELOAD_CMD=                           # hanya fpm, opsional: perintah reload bila opcache tidak cek ulang berkas
                                         # (mis. sudo systemctl reload php7.3-fpm). Kosong = tidak perlu reload.

# --- Beban mesin --------------------------------------------------------------
BA_PARALLEL=2                            # analyst yang boleh jalan bersamaan saat BA epic (ringan: baca kode).
                                         # Dev, build, test, e2e SELALU satu per satu.

# --- FE ---------------------------------------------------------------------
FE_STAGING_DIR=C:/Users/EqualSBY/AppData/Local/Temp/ksp-react-v5-build   # agent build ke sini, tidak pernah ke build/
FE_SERVE_DIR=build                       # relatif ke FE_DIR; developer menyajikannya dengan `serve`
FE_SERVE_PORT=4001                       # port `serve` untuk FE_DIR ini; 4000 dipakai checkout multidb (D:/dev/ksp-react)
E2E_PORT=4100                            # harness Playwright menyajikan FE_STAGING_DIR di port ini
CHROME_PATH=                             # opsional: path Chrome untuk e2e & render desain. Kosong = lokasi bawaan
                                         # (channel 'chrome'); preflight --long-run FAIL bila Chrome tidak ada

# --- QA ---------------------------------------------------------------------
# Semua checkout memakai server DB yang sama (kspdb.wsl:3307). Pilih DB tenant uji yang tidak sedang
# dipakai pipeline multidb, atau minta developer menyiapkannya.
QA_DB=api_cv_maju_jaya                   # DB tenant default untuk sesi QA
QA_DBS=api_cv_maju_jaya                  # DB yang boleh di-bind QA (koma). Isi >=2 DB supaya cek isolasi tenant jalan

# --- Profil lisensi (opsional) ----------------------------------------------
# Kosongkan PROFILES kalau tidak perlu menukar lisensi. Kalau diisi, PROFILE_DEFAULT wajib aktif
# di luar blok `scripts/profile.sh run <nama> -- ...`.
PROFILES=
PROFILE_DEFAULT=
# PROFILE_integrasi_LIC_DIR=D:/dev/ksp-erp-next/storage/app/attachments/test-license/integrasi
# PROFILE_integrasi_DB=api
# PROFILE_reguler_LIC_DIR=D:/dev/ksp-erp-next/storage/app/attachments/test-license/reguler
# PROFILE_reguler_DB=api_sidomaju
# PROFILE_integrasi_INTEGRATION=1        # opsional: profile.sh memverifikasi equal_integration lewat probe
# Selama `profile.sh run <p> -- ...`, runner qa-http memakai PROFILE_<p>_DB dan QA_<P>_USER/PASS (secrets.env).

# --- Profil login e2e (opsional) ---------------------------------------------
# Profil `default` = QA_USER di QA_DB; `user2` = QA_USER2. Profil lain `x`: QA_X_USER/QA_X_PASS di
# secrets.env, DB dari E2E_PROFILE_x_DB, lalu PROFILE_x_DB, lalu QA_DB. DB di luar QA_DBS -> SKIP.
# E2E_PROFILE_kasir_DB=api_cv_maju_jaya

