# Salin ke config/secrets.env (gitignored). Jangan pernah commit, cetak, atau tempel isinya ke laporan.
QA_USER=
QA_PASS=
QA_USER2=                 # opsional: user dengan hak lebih sedikit (uji permission 403)
QA_PASS2=
CLIENT_ID=4               # OAuth client password grant
# Per profil lisensi: QA_<PROFIL>_USER / QA_<PROFIL>_PASS, mis.
# QA_REGULER_USER=
# QA_REGULER_PASS=
